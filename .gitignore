# Other files dropped into bin/ stay untracked, but the notifier binary is
# committed on purpose (owner decision) so deployments carry it along.
bin/*
!bin/npc-telegram-notifier
node_modules/
.next/
out/
data/
*.tsbuildinfo
.env*
!.env.example
artifacts/backups/
__pycache__/
*.py[cod]
.agents/
.codex/
.aws/
.DS_Store
