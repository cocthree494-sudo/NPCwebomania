# On a server, use a persistent private directory for submissions.
# SUBMISSIONS_DIRECTORY=/absolute/private/path
# Optional: forward validated submissions to your own integration.
# FORM_WEBHOOK_URL=https://your-service.example/webhook
# Optional: also send every validated submission to a Telegram group.
# Create a bot with @BotFather, add it to the group, then set both values
# in the server environment only. Never commit the real token to Git.
# TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# TELEGRAM_CHAT_ID=-1001234567890
